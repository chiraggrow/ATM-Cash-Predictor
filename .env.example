ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://atm_cash_app:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5432/atm_cash_predictor
POSTGRES_USER=atm_cash_app
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_DB=atm_cash_predictor
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD_AT_LEAST_12_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost,http://localhost:8080,http://localhost:5173
DATASET_PATH=atm_cash.csv
OPERATIONAL_DATA_SOURCE=synthetic_simulation
MODEL_ARTIFACT_PATH=artifacts/atm-demand.joblib
TARGET_ACCURACY_PCT=85
MODEL_TEST_SIZE=0.2
MAX_FORECAST_DATA_AGE_DAYS=1
FORECAST_MODE=production
CREATE_SCHEMA_ON_STARTUP=false
